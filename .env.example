# Shopify Storefront API. The public token is read-only; the query still runs
# server-side, so nothing here is NEXT_PUBLIC_.
#
# Only SHOPIFY_STOREFRONT_TOKEN and RESEND_KEY are actually required — the rest
# default to the values below in lib/shopify/config.ts and lib/email.ts.
SHOPIFY_STOREFRONT_TOKEN=

# SHOPIFY_STORE_DOMAIN=ebupet-y0.myshopify.com
# SHOPIFY_API_VERSION=2025-01
# Newest series first, comma separated.
# SHOPIFY_SERIES_HANDLES=validation-drop-001

# Resend. Interest registrations and correspondence reach the office here.
RESEND_KEY=
# MAIL_FROM="MOCKBA Art Collective <hello@mockba.org>"
# MAIL_TO=hello@mockba.org

# notify | preorder — the item record CTA when checkout is not open.
# CTA_MODE=notify

# SITE_URL=https://mockba.org
